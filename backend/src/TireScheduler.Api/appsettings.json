{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "CookiesRequireHttps": true
  },
  "Auth": {
    "SessionHours": 12,
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    }
  }
}
