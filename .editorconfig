root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:warning
csharp_style_var_for_built_in_types = false:suggestion

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core writes these files (`dotnet ef migrations add`); they are not edited by hand except
# for data steps, so the code style analyzers skip them.
[**/Migrations/*.cs]
generated_code = true
